classDiagram
 accTitle: Class Hierarchy  Shared STAO Engine and Worker Specializations
 direction TB

 class AgenticWorkerMixin {
 <<shared STAO engine>>
 run_loop(spec, evidence, max_steps)
 _dispatch_tool(name, args, evidence)
 }

 class TerminalWorker {
 domain = terminal
 run_command / write_file
 }

 class BrowserWorker {
 domain = browser
 navigate / click / read_page
 }

 class DesktopWorker {
 domain = desktop
 launch_app / focus_window
 type_text / press_key
 }

 class GeminiProvider {
 model = gemini-2.5-flash
 complete_with_tools()
 }

 class CustomWorker {
 <<extension point>>
 domain = any_new_domain
 tools from new MCP server
 }

 AgenticWorkerMixin  <|--  TerminalWorker
 AgenticWorkerMixin  <|--  BrowserWorker
 AgenticWorkerMixin  <|--  DesktopWorker
 AgenticWorkerMixin  <|--  CustomWorker : add MCP server  new domain
 AgenticWorkerMixin  --> GeminiProvider : LLM calls
