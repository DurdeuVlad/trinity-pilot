%%{init: {'theme': 'base', 'themeVariables': {'background': '#ffffff', 'primaryColor': '#f5f5f5', 'primaryBorderColor': '#333', 'primaryTextColor': '#111', 'lineColor': '#555', 'edgeLabelBackground': '#ffffff', 'fontSize': '16px'}}}%%
flowchart TD
 accTitle: Task Pipeline  Planner / Orchestrator / Worker / Reviewer
 classDef user fill:#eef8ff,stroke:#444,stroke-width:2px,color:#111
 classDef plan fill:#f0eeff,stroke:#333,stroke-width:2px,color:#111
 classDef orch fill:#f5f0ff,stroke:#555,stroke-width:1px,color:#111
 classDef worker fill:#fff0f4,stroke:#555,stroke-width:2px,color:#111
 classDef review fill:#efffef,stroke:#555,stroke-width:2px,color:#111
 classDef ok fill:#efffef,stroke:#444,stroke-width:2px,color:#111
 classDef fail fill:#f5f5f5,stroke:#888,stroke-width:2px,stroke-dasharray:4,color:#111

 U(["User<br/>plain text request"]):::user

 P["Planner LLM<br/>breaks task into<br/>ordered ObjectiveSpec list"]:::plan

 O["Orchestrator<br/>picks next objective<br/>routes to matching Worker<br/>tracks retries"]:::orch

 W["Worker<br/>runs STAO loop<br/>sense -> think -> act -> observe"]:::worker

 R["Reviewer LLM<br/>compares evidence<br/>vs success criteria"]:::review

 PASS(["PASS<br/>next objective"]):::ok
 FAIL(["FAIL<br/>retry or abort"]):::fail
 END(["All objectives done<br/>result back to UI"]):::ok

 U --> P
 P -->|ObjectiveSpec list| O
 O -->|one objective| W
 W -->|evidence dict| R
 R -->|pass| PASS
 R -->|fail| FAIL
 PASS --> O
 FAIL -->|retry| O
 O -->|all done| END
