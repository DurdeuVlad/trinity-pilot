{
  "name": "The Chaos Agent",
  "description": "Environmental stress injection scenarios",
  "scenarios": [
    {
      "id": "ER-02",
      "input": "Open Chrome and navigate to https://github.com",
      "domain": "browser",
      "expected_status": "failed",
      "min_steps": 2,
      "pass_criteria": [
        "Detects failure",
        "Shows 'network error'",
        "Offers retry or cancel"
      ],
      "chaos": {
        "mode": "network",
        "offset_ms": 500
      }
    },
    {
      "id": "ER-04",
      "input": "Search for Python tutorials.",
      "domain": "browser",
      "expected_status": "failed",
      "min_steps": 1,
      "pass_criteria": [
        "Loading state shown",
        "Times out with message",
        "Does not hang"
      ],
      "chaos": {
        "mode": "cpu",
        "offset_ms": 0
      }
    },
    {
      "id": "ER-05",
      "input": "Open Notepad and type 'test'.",
      "domain": "desktop",
      "expected_status": "failed",
      "min_steps": 2,
      "pass_criteria": [
        "Detects subprocess death",
        "Partial completion shown",
        "Task marked failed"
      ],
      "chaos": {
        "mode": "kill",
        "offset_ms": 1000
      }
    },
    {
      "id": "ST-03",
      "input": "List files in Documents folder.",
      "domain": "cli",
      "expected_status": "completed",
      "min_steps": 1,
      "pass_criteria": [
        "Task completes despite stress",
        "No corruption"
      ],
      "chaos": {
        "mode": "cpu",
        "offset_ms": 0
      }
    }
  ]
}
