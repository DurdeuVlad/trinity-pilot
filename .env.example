# Copy this file to .env and fill in your values
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides
GEMINI_PLANNER_MODEL=gemini-1.5-pro
GEMINI_WORKER_MODEL=gemini-1.5-flash

# Temporal server (run locally: https://docs.temporal.io/cli)
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# SQLite database path
DB_PATH=trinity_pilot.db

# UI debug mode: set true to show raw logs, JSON payloads, workflow IDs in the chat UI
TRINITY_DEBUG_MODE=false

# Route worker dispatch through real MCP servers (subprocess per domain) instead
# of in-process worker calls. Default false = today's verified in-process path.
TRINITY_MCP_DISPATCH=false
