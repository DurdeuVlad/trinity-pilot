# Copy this file to .env and fill in your values
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=120

# Optional Gemini configuration when LLM_PROVIDER=gemini
GEMINI_PLANNER_MODEL=gemini-2.5-flash
GEMINI_WORKER_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=120

# SQLite database path
DB_PATH=trinity_pilot.db

# UI debug mode: set true to show raw logs, JSON payloads, workflow IDs in the chat UI
TRINITY_DEBUG_MODE=false

# Objectives are always dispatched through their domain MCP server.
